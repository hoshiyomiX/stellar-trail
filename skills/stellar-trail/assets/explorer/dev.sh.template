#!/usr/bin/env bash
# ============================================================================
# dev.sh — PERSISTENT BOOT HOOK (run automatically by /start.sh at every boot)
#
# Invoked by /start.sh:
#   sudo -u z bash /home/z/my-project/.zscripts/dev.sh
#
# NOTE (stellar-trail v3.6.7): this file is the LEGACY template kept for
# reference. The live boot hook is GENERATED by bootstrap-sandbox.sh (see
# scripts/bootstrap-sandbox.sh, section 7) — regenerate it with:
#   bash download/stellar-trail/scripts/bootstrap-sandbox.sh [--with-*]
#
# PURPOSE:
#   1. POPUP "All files in task" MITIGATION: the preview panel & popup on the
#      browser side cannot be overridden from the container (the frontend is
#      served by the platform). What CAN be controlled is the file inventory
#      that gets registered — this hook keeps download/ lean by moving
#      eval/audit/intermediate artifacts to /home/z/my-project/archive/
#      automatically at every boot.
#   2. FULLSTACK GUARD: when a package.json exists (Next.js project), this
#      script delegates to the standard flow (bun install -> db:push ->
#      dev server + mini-services) so the hook never breaks the web project.
#      Note: if the fullstack-dev skill writes its own dev.sh, that one wins
#      (correct behavior).
#   3. TASK FILES EXPLORER (v1.2): starts explorer.py on 127.0.0.1:3000 —
#      upstream of the platform preview ingress — as the functional
#      replacement for the "All files in task" popup. The port-conflict
#      guard lives in explorer.sh (package.json/Next.js always wins).
#   4. SKILL RESTORE — owned by the bootstrap-generated dev.sh: the
#      stellar-trail installation is restored by cache-replay from the
#      canonical copy (download/stellar-trail/, manifest SHA-256 verified,
#      with a no-downgrade version gate). This legacy template no longer
#      runs any skill repair: the multi-source repair chain was retired in
#      v3.6.7 — integrity monitoring is verify-only (watcher), and
#      remediation is the single install command
#      (npx skills add hoshiyomiX/stellar-trail).
#   5. REPO REFRESH (v2): repo-snapshot.sh --apply-auto refreshes the
#      restore archive (internal debounce + cooldown) — the primary
#      anti-rollback layer.
#
# MANUAL USAGE:
#   bash .zscripts/dev.sh            # run the tidy now (without waiting for boot)
#   bash .zscripts/dev.sh --status   # view download/ inventory + boot log
#
# UNDO: archived files can be restored at any time:
#   mv /home/z/my-project/archive/<name> /home/z/my-project/download/
# ============================================================================

PROJECT="/home/z/my-project"
DOWNLOAD="$PROJECT/download"
ARCHIVE="$PROJECT/archive"
BOOTLOG="$PROJECT/.zscripts/boot.log"
LOCKDIR="/tmp/dev-sh.lock"

ts() { date '+%Y-%m-%d %H:%M:%S'; }
log() { echo "[$(ts)] $*" >> "$BOOTLOG"; echo "[dev.sh] $*"; }

# ---------------------------------------------------------------------------
# --status MODE: inspection only, changes nothing
# ---------------------------------------------------------------------------
if [ "$1" = "--status" ]; then
    echo "=== download/ (top-level) ==="
    ls -1 "$DOWNLOAD" 2>/dev/null
    echo
    echo "=== archive/ ==="
    ls -1 "$ARCHIVE" 2>/dev/null || echo "(empty)"
    echo
    echo "=== boot.log (last 15 lines) ==="
    tail -15 "$BOOTLOG" 2>/dev/null || echo "(none yet)"
    echo
    bash "$PROJECT/.zscripts/watcher.sh" --status 2>/dev/null || true
    exit 0
fi

# ---------------------------------------------------------------------------
# 0. Anti double-run (10-minute lock; a stale lock is taken over automatically)
# ---------------------------------------------------------------------------
if [ -d "$LOCKDIR" ]; then
    if [ -z "$(find "$LOCKDIR" -maxdepth 0 -mmin -10 2>/dev/null)" ]; then
        rm -rf "$LOCKDIR"   # lock older than 10 minutes -> stale
    else
        log "LOCK active, skip double run"
        exit 0
    fi
fi
mkdir "$LOCKDIR" 2>/dev/null || exit 0
trap 'rm -rf "$LOCKDIR"' EXIT
UP_S=$(awk '{printf "%.0f", $1}' /proc/uptime 2>/dev/null || echo "?")
log "dev.sh start (container uptime ${UP_S}s; <300s = via /start.sh hook, larger = manual)"

# ---------------------------------------------------------------------------
# 0.5 SKILL RESTORE — NOT performed here. The bootstrap-generated dev.sh
#     owns it: cache-replay from canonical download/stellar-trail/ with a
#     no-downgrade version gate (see scripts/bootstrap-sandbox.sh). The
#     retired multi-source repair chain had its duties inherited by: the
#     watcher's verify-only integrity checks (alarm + install hint), the
#     boot-hook cache replay above, and the single install command for real
#     repairs (npx skills add hoshiyomiX/stellar-trail).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 1. FULLSTACK GUARD — delegate to the standard flow when package.json exists
#    (/start.sh uses if/elif: the existence of dev.sh REPLACES the bun flow,
#    so the bun flow must be replicated here to keep the web project alive)
# ---------------------------------------------------------------------------
if [ -f "$PROJECT/package.json" ]; then
    log "package.json detected -> delegating to the standard fullstack flow"
    cd "$PROJECT" || true
    bun install        >> "$BOOTLOG" 2>&1 || log "WARN: bun install failed"
    bun run db:push    >> "$BOOTLOG" 2>&1 || log "WARN: db:push failed"
    nohup bun run dev  >> "$BOOTLOG" 2>&1 &
    log "Next.js dev server started in the background"
    for d in "$PROJECT"/mini-services/*/; do
        [ -f "${d}package.json" ] || continue
        (
            cd "$d" || exit 0
            bun install >> "$BOOTLOG" 2>&1
            nohup bun run dev >> "$BOOTLOG" 2>&1 &
        )
        log "mini-service started: $d"
    done
fi

# ---------------------------------------------------------------------------
# 2. POPUP MITIGATION — tidy download/ (idempotent, safe to re-run)
# ---------------------------------------------------------------------------
tidy_download() {
    if [ ! -d "$DOWNLOAD" ]; then
        log "download/ missing, skip tidy"
        return 0
    fi
    mkdir -p "$ARCHIVE"
    cd "$DOWNLOAD" || return 0
    local moved=0 item dest
    for item in *; do
        [ -e "$item" ] || continue

        # -- 2a. PROTECT main deliverables (never moved) --
        case "$item" in
            README.md|*.md|*.skill|*.pdf|*.docx|*.xlsx|*.pptx|*.csv|*.png|*.jpg|*.jpeg|*.gif|*.zip|stellar-trail)
                continue
                ;;
        esac

        # -- 2b. artifact patterns to archive --
        case "$item" in
            *-eval|*-results.json|*-audit-results.json|audit-results.json|*-cover.html|workflow-guardian|memory-guardian)
                dest="$ARCHIVE/$item"
                if [ -e "$dest" ]; then
                    dest="$ARCHIVE/${item}.$(date +%Y%m%d%H%M%S)"
                fi
                if mv -- "$item" "$dest" 2>>"$BOOTLOG"; then
                    moved=$((moved+1))
                    log "ARCHIVE: $item -> $dest"
                else
                    log "WARN: failed to move $item"
                fi
                ;;
        esac
    done
    log "tidy done: $moved item(s) moved to archive/"
    return 0
}

tidy_download

# ---------------------------------------------------------------------------
# 3. ENSURE THE WATCHER DAEMON IS ALIVE (applies at boot and on manual runs)
#    watcher.sh --ensure = no-op when already running; double-fork orphan when
#    not -> safety net: boot hook + per-session M0 + manual, three paths
#    leading to one daemon
# ---------------------------------------------------------------------------
if [ -f "$PROJECT/.zscripts/watcher.sh" ]; then
    bash "$PROJECT/.zscripts/watcher.sh" --ensure >> "$BOOTLOG" 2>&1 || log "WARN: watcher --ensure failed"
fi

# ---------------------------------------------------------------------------
# 4. ENSURE THE TASK FILES EXPLORER IS ALIVE (functional popup replacement)
#    explorer.sh --ensure is idempotent; the Next.js guard lives inside it.
# ---------------------------------------------------------------------------
if [ -f "$PROJECT/.zscripts/explorer.sh" ]; then
    bash "$PROJECT/.zscripts/explorer.sh" --ensure >> "$BOOTLOG" 2>&1 || log "WARN: explorer --ensure failed"
fi

# ---------------------------------------------------------------------------
# 5. REPO REFRESH (v2): refresh the restore archive via the double gate
#    inside repo-snapshot.sh --apply-auto (debounce + cooldown). Safe to call
#    periodically; no-op when nothing material changed.
# ---------------------------------------------------------------------------
if [ -f "$PROJECT/.zscripts/repo-snapshot.sh" ]; then
    bash "$PROJECT/.zscripts/repo-snapshot.sh" --apply-auto >> "$BOOTLOG" 2>&1 || log "WARN: repo refresh failed"
fi

log "dev.sh done (download/ lean, explorer maintained, skill restore owned by the bootstrap hook, repo.tar fresh)"
